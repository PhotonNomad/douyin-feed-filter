{
  "manifest_version": 3,
  "name": "抖音视频屏蔽（无页面按钮）",
  "version": "0.4.5",
  "description": "只做数据层过滤，不在视频页面上显示屏蔽按钮或浮层。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.douyin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音视频屏蔽（无页面按钮）"
  },
  "minimum_chrome_version": "111"
}
