{
  "manifest_version": 3,
  "name": "抖音视频屏蔽",
  "version": "0.5.22",
  "description": "基于抖音网页版返回的官方字段，在网络响应层屏蔽指定 BGM、博主或标签。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.douyin.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音视频屏蔽",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "512": "icons/icon512.png"
    }
  },
  "minimum_chrome_version": "111"
}
